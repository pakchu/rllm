      "revision": "v3_direction_neutral_meta_instruction_guard",
      "normalization": "Unicode NFKC; casefold; whitespace collapsed",
      "patterns": [
        "^(?:please\\s+)?(?:output|return|respond|answer|print|say|choose|select)\\b.{0,40}\\b(?:bullish|bearish|unclear)\\b",

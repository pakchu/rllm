  "mechanism": {
    "claim": "When a large share of six-hour realized variance is discontinuous, the signed cubic jump and the recovery of taker imbalance distinguish sponsored continuation from an exhausted shock. Aligned positive states map long and aligned negative states map short.",
    "why_distinct": "JVFCR uses causal jump/bipower decomposition plus aggressive-flow recovery. It is not a threshold, direction, hold, model, or diagnostic-control repair of any terminal 2026-08 candidate.",
    "why_suited_to_volatile_regimes": "the jump-ratio gate explicitly requires discontinuous realized variation and therefore suppresses quiet-market signals"
  },
  "feature_contract": {
    "bar": "completed BTCUSDT perpetual 5m bar",
    "return": "log(close_t/close_t-1)",
    "window_bars": 72,
    "realized_variation": "sum(return^2) over 72 bars",
    "bipower_variation": "(pi/2)*sum(abs(return_t)*abs(return_t-1)) over 72 bars",
    "jump_ratio": "max(realized_variation-bipower_variation,0)/realized_variation",
    "signed_jump": "sum(return^3)/realized_variation^(3/2) over 72 bars",
    "taker_imbalance": "clip(2*taker_buy_quote/quote_asset_volume-1,-1,1)",
    "flow_recovery": "12-bar mean taker imbalance minus 48-bar mean taker imbalance",
    "finite_positive_volume_required": true,
    "no_imputation": true
  },
  "frozen_states": {
    "long_jump_continuation": {
      "gates": [
        {
          "feature": "jv_jump_ratio_72",
          "op": ">=",

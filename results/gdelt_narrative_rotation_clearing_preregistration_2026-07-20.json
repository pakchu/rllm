    "base_features": {
      "xA": "log((adoption + 0.5) / (broad + 0.5))",
      "xB": "log((broad + 0.5) / (global + 0.5))",
      "xC": "log((constraint + 0.5) / (broad + 0.5))",
      "xF": "log((failure + 0.5) / (broad + 0.5))"
    },
    "config": {
      "attention_penalty": 0.25,
      "decision_clock": "source_available_at",
      "entry_delay_minutes": 10,
